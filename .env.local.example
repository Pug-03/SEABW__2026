# Copy this file to .env.local and fill in your credentials.

# ─── Supabase (optional) ──────────────────────────────────────────────────────
# Without these, the chat works in local-only mode (no real-time sync).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OTP store (Redis) ────────────────────────────────────────────────────────
# Used by /api/auth/send-otp + /api/auth/verify-otp to hold bcrypt-hashed OTPs
# and rate-limit counters with a 5-minute TTL. When unset, the app falls back
# to an IN-MEMORY store for LOCAL DEV ONLY (not safe across instances) — always
# set REDIS_URL in production.
REDIS_URL=redis://default:password@localhost:6379

# ─── OTP delivery · Email (Nodemailer / SMTP) ─────────────────────────────────
# When unset in development, email OTPs are logged to the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASS=your-smtp-password
SMTP_FROM="VibeTrip <no-reply@vibetrip.app>"

# ─── OTP delivery · SMS (Twilio) ──────────────────────────────────────────────
# When unset in development, SMS OTPs are logged to the server console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555555555
